# 复制为 .env 后填写（所有数据来源共用）：cd agent-tuning && cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交。

# Gmail 地址
GMAIL_USER=you@gmail.com

# Gmail「应用专用密码」（16 位，不是登录密码）。获取方法见 README.md「1. 准备凭据」。
# 空格可留可去。
GMAIL_APP_PASSWORD=

# 筛选每日报告邮件的 Gmail 搜索语句（与 Gmail 网页搜索框语法相同）。
# 先运行 `python3 sources/mail/fetch_mail.py --list` 看收件箱里那封邮件的发件人和标题，再填这里。
# 例：MAIL_QUERY=from:sender@example.com subject:问藏简报
MAIL_QUERY=

# 可选：IMAP 服务器（默认 Gmail）
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
