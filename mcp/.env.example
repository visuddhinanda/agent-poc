# Streamable HTTP 监听端口
PORT=3000
# 绑定地址：本机用 127.0.0.1（默认，带 DNS rebinding 防护）；供远程/容器/LangGraph 调用时设 0.0.0.0
MCP_HOST=127.0.0.1
# 绑定非回环地址时的 Host 白名单（逗号分隔），例如：mcp.example.com,localhost
MCP_ALLOWED_HOSTS=

# —— 服务端配置（无状态：server 不落任何凭据） ——
# 目标 WikiPali API 地址（默认 www 稳定版；next 是最新代码，staging/local 是独立库）
# WIKIPALI_API_URL=https://next.wikipali.org/api
