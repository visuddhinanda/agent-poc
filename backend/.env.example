# DeepSeek API（必填，在 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-your-key-here

# 以下为可选覆盖项，默认值即 DeepSeek 官方 OpenAI 兼容接口
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# WikiPali MCP server（无状态 Streamable HTTP，见 ../mcp）
# 后端通过 langchain-mcp-adapters 连接它，加载 wikipali_* 工具
WIKIPALI_MCP_URL=http://127.0.0.1:3000/mcp

# 写端凭据（modelToken / userToken）不在此配置——后端无状态，凭据只能随请求的
# HTTP 头传入（Authorization: Bearer <modelToken> / X-Wikipali-User-Token: <userToken>），
# 由客户端持有，经 CopilotKit Runtime 逐请求转发。详见 backend/README.md「写端（可选）」。
