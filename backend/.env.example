# DeepSeek API（必填，在 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-your-key-here

# 以下为可选覆盖项，默认值即 DeepSeek 官方 OpenAI 兼容接口
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# WikiPali MCP server（无状态 Streamable HTTP，见 ../mcp）
# 后端通过 langchain-mcp-adapters 连接它，加载 wikipali_* 工具
WIKIPALI_MCP_URL=http://127.0.0.1:3000/mcp

# 写端工具（可选）：若要走写句子/术语/批注，配这两个 token
# （由 ../mcp 的 `npm run login` 与 wikipali_ensure_model 取得，存在客户端侧）
# WIKIPALI_MODEL_TOKEN=
# WIKIPALI_USER_TOKEN=
